# .dockerignore — keep Docker build context lean and secure

# Secrets — never bake these into the image
.env
*.env
.env.*
!.env.example

# Version control
.git
.gitignore
.github

# Python build artefacts
__pycache__
*.py[cod]
*.egg-info
.venv
venv
dist
build

# Local databases
*.db
*.sqlite
*.sqlite3
hsn_dev.db

# Test files (not needed at runtime)
tests/
pytest.ini
setup.cfg
.coveragerc

# Frontend (separate deployment)
hsn-frontend/

# Docs / IDE / OS
*.md
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# CI
.github
.circleci

# Large data files (seeded from DB, not from local files)
data/hsn_codes.csv
data/hsn_codes_full.csv
