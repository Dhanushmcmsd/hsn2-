# hsn-frontend/.env.local.example
# Local dev — direct to FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# On Vercel production, use EITHER:
#   BACKEND_URL=https://your-service.onrender.com   (proxy via /api — recommended)
# OR
#   NEXT_PUBLIC_API_URL=https://your-service.onrender.com   (direct + CORS on Render)
