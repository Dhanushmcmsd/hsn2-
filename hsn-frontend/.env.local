# hsn-frontend/.env.local  (for local dev)
# Copy this file to .env.local and fill in your values.
# In Vercel dashboard → Settings → Environment Variables, add these same keys.

# Your Render backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.onrender.com

# NextAuth (required if you use next-auth)
NEXTAUTH_URL=https://hsn2.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Must match JWT_SECRET on the Render backend
JWT_SECRET=same-secret-as-your-render-backend
