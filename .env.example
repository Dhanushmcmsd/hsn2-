# .env.example — HSN Classifier
# Copy to .env for local development:  cp .env.example .env
# NEVER commit .env to git.
#
# For production (Render), set these in the Render dashboard or render.yaml.
# For Supabase DB and Upstash Redis, see comments per variable below.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # set to "production" on Render

# ── Security (REQUIRED — startup fails if these remain as defaults) ───────────
# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-32-chars-minimum
API_KEY=dev-api-key
ADMIN_API_KEY=dev-admin-key  # must differ from API_KEY

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DEV — SQLite (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./hsn_dev.db

# PRODUCTION — Supabase free PostgreSQL:
#   1. Create project at https://supabase.com (free tier, no credit card)
#   2. Go to: Settings → Database → Connection string → URI
#   3. Copy the URI and change the scheme:
#      postgresql://  →  postgresql+asyncpg://
#   Example:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
#
# IMPORTANT: Supabase free DB pauses after 7 days of inactivity.
# Keep it active by pinging /health from your Render service or cron-job.org.

# ── Redis ─────────────────────────────────────────────────────────────────────
# LOCAL DEV:
REDIS_URL=redis://localhost:6379/0

# PRODUCTION — Upstash free Redis:
#   1. Create database at https://upstash.com (free tier: 10k cmd/day)
#   2. Go to: your database → Details → Redis URL (starts with rediss://)
#   Example:
# REDIS_URL=rediss://:your-password@your-endpoint.upstash.io:6379
#
# NOTE: Upstash uses TLS — use rediss:// (double-s), not redis://

# Docker Compose only (not used by the app directly):
POSTGRES_USER=hsn
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=hsn

# Root `main.py` (gunicorn main:app): set APP_ENV=production and strong secrets (32+ chars).

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcard * in production.
# Include every Vercel hostname you use (production + preview), e.g.:
#   https://hsn2.vercel.app,https://hsn-app.vercel.app,https://hsn2-git-main-<team>.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production example:
# CORS_ORIGINS=https://hsn2.vercel.app,https://hsn-app.vercel.app

# ── Vercel (Next.js frontend — set in Vercel → Settings → Environment Variables) ──
# Option A — Same-origin proxy (recommended): browser calls /api; Next rewrites to backend.
#   BACKEND_URL=https://your-service.onrender.com
# Option B — Direct browser → API (requires full CORS_ORIGINS on Render):
#   NEXT_PUBLIC_API_URL=https://your-service.onrender.com
# You can set BACKEND_URL only and omit NEXT_PUBLIC_API_URL to avoid hitting localhost in prod.

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_PASSWORD=

# ── Grafana (local docker-compose only) ───────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Model / Matching ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.55
REVIEW_THRESHOLD=0.55
AMBIGUITY_THRESHOLD=0.10
CACHE_TTL=3600
SEARCH_CACHE_TTL=3600
NEG_CACHE_TTL=300                       # cache empty results to spare Neon
MULTI_SEARCH_TIMEOUT_INVERTED_MS=800    # per-layer hard timeouts for /search/multi
MULTI_SEARCH_TIMEOUT_FUZZY_MS=800
MULTI_SEARCH_TIMEOUT_FAISS_MS=1500
MULTI_SEARCH_TIMEOUT_VERIFIED_MS=500
MULTI_SEARCH_TIMEOUT_PREFIX_MS=300
RATE_LIMIT_PER_MINUTE=60
