# ── Required (startup will fail in production if these are defaults) ──────────
APP_ENV=development

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-32-chars-minimum
API_KEY=dev-api-key
ADMIN_API_KEY=dev-admin-key

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (SQLite — no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./hsn_dev.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://hsn:yourpassword@localhost:5432/hsn

POSTGRES_USER=hsn
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=hsn

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_PASSWORD=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Model / Matching ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.55
REVIEW_THRESHOLD=0.55
AMBIGUITY_THRESHOLD=0.10
CACHE_TTL=3600
RATE_LIMIT_PER_MINUTE=60
