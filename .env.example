# .env.example — HSN Classifier
# Copy to .env for local development:  cp .env.example .env
# NEVER commit .env to git.
#
# For production (Render), set these in the Render dashboard or render.yaml.
# For Supabase DB and Upstash Redis, see comments per variable below.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # set to "production" on Render

# ── Security (REQUIRED — startup fails if these remain as defaults) ───────────
# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-32-chars-minimum
API_KEY=dev-api-key
ADMIN_API_KEY=dev-admin-key  # must differ from API_KEY

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DEV — SQLite (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./hsn_dev.db

# PRODUCTION — Supabase free PostgreSQL:
#   1. Create project at https://supabase.com (free tier, no credit card)
#   2. Go to: Settings → Database → Connection string → URI
#   3. Copy the URI and change the scheme:
#      postgresql://  →  postgresql+asyncpg://
#   Example:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
#
# IMPORTANT: Supabase free DB pauses after 7 days of inactivity.
# Keep it active by pinging /health from your Render service or cron-job.org.

# ── Redis ─────────────────────────────────────────────────────────────────────
# LOCAL DEV:
REDIS_URL=redis://localhost:6379/0

# PRODUCTION — Upstash free Redis:
#   1. Create database at https://upstash.com (free tier: 10k cmd/day)
#   2. Go to: your database → Details → Redis URL (starts with rediss://)
#   Example:
# REDIS_URL=rediss://:your-password@your-endpoint.upstash.io:6379
#
# NOTE: Upstash uses TLS — use rediss:// (double-s), not redis://

# Docker Compose only (not used by the app directly):
POSTGRES_USER=hsn
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=hsn

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcard * in production.
CORS_ORIGINS=http://localhost:3000
# Production example:
# CORS_ORIGINS=https://hsn2.vercel.app

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_PASSWORD=

# ── Grafana (local docker-compose only) ───────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Model / Matching ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.55
REVIEW_THRESHOLD=0.55
AMBIGUITY_THRESHOLD=0.10
CACHE_TTL=3600
RATE_LIMIT_PER_MINUTE=60

# ── Notifications / Email ─────────────────────────────────────────────────────
NOTIFICATION_EMAIL_FROM=notifications@yourdomain.com
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
