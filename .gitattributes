# hsn_app_fixed/.gitattributes

# Auto-detect text files and normalize
* text=auto

# Force LF for these file types (important for shell scripts + Docker)
*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.xlsx  binary
*.zip   binary